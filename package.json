{
  "name": "@bounded-authority-protocol/signer",
  "version": "2.0.1",
  "description": "Holder/issuer companion signer for the Bounded Authority Protocol. Signs proofs, grants, boundary anchors, and key transitions through a caller-owned key handle whose private key never enters the library.",
  "license": "Apache-2.0",
  "keywords": [
    "bounded-authority-protocol",
    "authorization",
    "capability",
    "grant",
    "proof-of-possession",
    "jws",
    "ed25519",
    "es256",
    "webcrypto",
    "agents",
    "mcp"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "usage-rules.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/bounded_authority_signer_typescript.git"
  },
  "homepage": "https://baselabs.github.io/bounded_authority_signer_typescript/",
  "bugs": "https://github.com/baselabs/bounded_authority_signer_typescript/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json && tsc -p browser/tsconfig.json",
    "lint": "eslint .",
    "guard:browser": "node tools/browser-guard.mjs",
    "size": "pnpm build && node --test --import tsx/esm test/bundle-size.ts && node tools/bundle-size.mjs",
    "test": "node --test --import tsx/esm test/*.test.ts",
    "test:portable": "node --test --conditions=bap-portable --import tsx/esm test/*.test.ts",
    "test:gates": "node --test --import tsx/esm test/gates.test.ts",
    "test:tarball": "pnpm build && BAP_SAMPLE_MODE=candidate node --test --import tsx/esm test/tarball.ts test/reader.ts",
    "pack:release": "node tools/pack.mjs",
    "test:runtimes": "node --test --import tsx/esm test/runtimes.ts",
    "test:browser": "node --test --import tsx/esm test/browser.ts",
    "check:currency": "node tools/check-currency.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:site": "node web/build.mjs && esbuild web/main.ts --bundle --minify --format=iife --target=es2022 --outfile=site-dist/app.js",
    "guard:site": "node tools/browser-guard.mjs --scan site-dist/app.js",
    "site": "pnpm typecheck:web && pnpm build:site && pnpm guard:site && pnpm docs:api:release && pnpm test:network:pages && pnpm check:site",
    "docs:api": "typedoc",
    "docs:api:release": "node tools/build-release-api.mjs",
    "test:network": "node --test --import tsx/esm test/*.network.ts",
    "check:site": "node tools/check-site-badge.mjs",
    "docs:samples:local": "BAP_SAMPLE_MODE=candidate node --test --import tsx/esm test/reader.ts",
    "docs:samples:published": "BAP_SAMPLE_MODE=published node --test --import tsx/esm test/reader.ts",
    "notebooks:local": "pnpm build && uv run --frozen python scripts/check_notebooks.py --local",
    "notebooks:published": "uv run --frozen python scripts/check_notebooks.py --published",
    "test:playground": "BAP_SAMPLE_MODE=candidate node --test --import tsx/esm test/playground.ts",
    "test:network:published": "node --test --import tsx/esm test/*.published.ts",
    "test:network:pages": "node --test --import tsx/esm test/*.pages.ts",
    "docs:checks:published": "pnpm docs:samples:published && pnpm test:network:published && pnpm build && pnpm build:site && pnpm exec playwright install --with-deps chromium firefox webkit && BAP_BROWSERS=chromium,firefox,webkit pnpm test:playground:published",
    "test:playground:published": "BAP_SAMPLE_MODE=published node --test --import tsx/esm test/playground.ts"
  },
  "dependencies": {
    "@bounded-authority-protocol/verifier": "^2.0.1"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@types/node": "^26.6.6",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "markdown-it": "15.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
