{
  "name": "@bounded-authority-protocol/signer",
  "version": "0.4.0",
  "description": "Holder/issuer companion signer for the Bounded Authority Protocol — signs proofs, grants, boundary anchors, and key transitions through a caller-owned key handle whose private key never enters the library.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/bounded_authority_signer_typescript.git"
  },
  "homepage": "https://baselabs.github.io/bounded_authority_signer_typescript/",
  "bugs": "https://github.com/baselabs/bounded_authority_signer_typescript/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "lint": "eslint .",
    "guard:browser": "node tools/browser-guard.mjs",
    "test": "node --test --import tsx/esm test/*.test.ts",
    "test:gates": "node --test --import tsx/esm test/gates.test.ts",
    "test:tarball": "pnpm build && node --test --import tsx/esm test/tarball.ts",
    "check:currency": "node tools/check-currency.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:site": "node web/build.mjs && esbuild web/main.ts --bundle --minify --format=iife --target=es2022 --outfile=site-dist/app.js --alias:node:crypto=./web/shim/node-crypto.ts --inject:./web/shim/buffer-global.ts"
  },
  "dependencies": {
    "@bounded-authority-protocol/verifier": "^0.7.0"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.5",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
